+# ---- V35 input helpers (pure: no network, no ffmpeg) ----
+norm_input() {
+  # Arabic-Indic (٠-٩) and Persian (۰-۹) digits -> 0-9, Arabic decimal and
+  # thousands signs -> . and , ; spaces around the answer removed.
+  printf '%s' "$1" | tr -d '\r' | sed \
+    -e 's/٠/0/g; s/١/1/g; s/٢/2/g; s/٣/3/g; s/٤/4/g' \
+    -e 's/٥/5/g; s/٦/6/g; s/٧/7/g; s/٨/8/g; s/٩/9/g' \
+    -e 's/۰/0/g; s/۱/1/g; s/۲/2/g; s/۳/3/g; s/۴/4/g' \
+    -e 's/۵/5/g; s/۶/6/g; s/۷/7/g; s/۸/8/g; s/۹/9/g' \
+    -e 's/٫/./g; s/٬/,/g' \
+    -e 's/^[[:space:]]*//; s/[[:space:]]*$//'
+}
+
+is_yes() {
+  case "$(norm_input "$1")" in
+    y|Y|yes|YES|Yes|ن|نعم|اه|ايوه|أيوه) return 0 ;;
+  esac
+  return 1
+}
+
+# Only RFC 3986 URL characters (ASCII). Arabic text or punctuation glued to
+# a link in a share text is therefore never taken as part of the link.
+URL_RE="https?://[A-Za-z0-9._~:/?#@!\$&'()*+,;=%-]+"
+
+extract_urls() {
+  # stdin or file(s) -> every http(s) link, one per line, trailing
+  # sentence punctuation removed.
+  LC_ALL=C grep -Eo "$URL_RE" "$@" | sed "s/[]),.;:!?'\"]*\$//"
+}
+
+is_temp_artifact() {
+  # Files in a job folder that are NOT a finished download.
+  case "$1" in
+    *.part|*.part-Frag*|*.ytdl|*.temp|*.tmp|*.json|*.description|*.dump) return 0 ;;
+    *.srt|*.vtt|*.ass|*.lrc|*.txt|*.annotations.xml) return 0 ;;
+    *\].f[0-9]*.*) return 0 ;;   # unmerged "[id].f137.mp4" piece
+  esac
+  return 1
+}
+
+budget_kbps() {
+  # $1 MB ; $2 seconds -> video kbit/s that fits (0.92 margin, 128k audio)
+  awk -v mb="$1" -v d="$2" 'BEGIN { if (d <= 0) { print -1; exit } v = mb * 8192 * 0.92 / d - 128; printf "%d", v }'
+}
