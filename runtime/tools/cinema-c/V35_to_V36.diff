+# ---------------------------------------------------------------------
+# V36 SmartMedia (from V31): Instagram photo posts / carousels via gallery-dl
+# ---------------------------------------------------------------------
+find_gallery() {
+  GALLERY=''
+  GALLERY_MODE=''
+  if have gallery-dl && gallery-dl --version >/dev/null 2>&1; then
+    GALLERY='gallery-dl'; GALLERY_MODE='binary'; return 0
+  fi
+  if have python3 && python3 -m gallery_dl --version >/dev/null 2>&1; then
+    GALLERY='python3'; GALLERY_MODE='module'; return 0
+  fi
+  return 1
+}
+
+run_gallery() {
+  if [ "$GALLERY_MODE" = 'module' ]; then
+    "$GALLERY" -m gallery_dl "$@"
+  else
+    "$GALLERY" "$@"
+  fi
+}
+
+install_or_update_deps() {
+  if ! have python3; then
+    err 'Python3 is missing. a-Shell needs Python to install these packages.'
+    return 1
+  fi
+  say '[C] Installing/updating yt-dlp and gallery-dl (explicit request)...'
+  if python3 -m pip install --user --upgrade yt-dlp gallery-dl; then
+    say '[C] Packages updated. Run: c --doctor'
+    return 0
+  fi
+  err 'pip installation failed; check a-Shell Python/pip and network access.'
+  return 1
+}
+
+is_instagram_post() {
+  case "${1:-$INPUT}" in
+    https://instagram.com/p/*|https://www.instagram.com/p/*|https://m.instagram.com/p/*|http://instagram.com/p/*|http://www.instagram.com/p/*)
+      return 0 ;;
+  esac
+  return 1
+}
+
+instagram_post_slug() {
+  slug=$(printf '%s\n' "${1:-$INPUT}" | sed -n 's#^.*/p/\([^/?][^/?]*\).*#\1#p' | tr -cd 'A-Za-z0-9_-')
+  [ -n "$slug" ] || slug='post'
+  printf '%s' "$slug"
+}
+
+is_gallery_media() {
+  case "$1" in
+    *.jpg|*.JPG|*.jpeg|*.JPEG|*.png|*.PNG|*.webp|*.WEBP|*.gif|*.GIF|*.heic|*.HEIC|*.avif|*.AVIF|*.mp4|*.MP4|*.mov|*.MOV|*.m4v|*.M4V|*.webm|*.WEBM|*.mkv|*.MKV)
+      return 0 ;;
+  esac
+  return 1
+}
+
+# Downloads every asset of the post into its own folder and fills OUTPUTS /
+# OUTPUT_FILE / OUTPUT_COUNT, so finish() (Photos SAFE or Files) works as usual.
+run_gallery_download() {
+  if ! find_gallery; then
+    err 'Instagram photos/carousels need gallery-dl.'
+    say 'Install it in a-Shell with: c --setup'
+    say 'Or: python3 -m pip install --user --upgrade gallery-dl'
+    return 1
+  fi
+  if [ -n "${WORK_DIR:-}" ] && [ -d "$WORK_DIR" ]; then
+    rm -rf "$WORK_DIR" 2>/dev/null || true
+  fi
+  new_work_dir
+  g_work="$WORK_DIR/gallery"
+  mkdir -p "$g_work" || return 1
+  say ''
+  say '[C] Gallery mode: downloading every photo/video of the post...'
+  set -- --no-input -D "$g_work" --no-mtime --retries 3
+  [ -z "$COOKIES" ] || set -- "$@" --cookies "$COOKIES"
+  set -- "$@" "$INPUT"
+  # An extractor may exit non-zero after saving some items: success = files exist.
+  g_rc=0
+  run_gallery "$@" || g_rc=$?
+  g_count=0; g_imgs=0; g_vids=0
+  for f in "$g_work"/*; do
+    [ -f "$f" ] || continue
+    is_gallery_media "$f" || continue
+    is_temp_artifact "${f##*/}" && continue
+    g_count=$((g_count + 1))
+    if is_video_file "$f"; then g_vids=$((g_vids + 1)); else g_imgs=$((g_imgs + 1)); fi
+  done
+  if [ "$g_count" -eq 0 ]; then
+    err 'gallery-dl did not produce any complete media files.'
+    if [ -z "$COOKIES" ]; then
+      say 'If the post needs a login, give your own cookies file:'
+      say '  c --cookies cookies.txt --smart "POST_URL"'
+    fi
+    return 1
+  fi
+  stamp=$(date '+%Y%m%d_%H%M%S' 2>/dev/null || printf 'job')
+  if is_instagram_post; then tag="Instagram_$(instagram_post_slug)"; else tag='Cinema_Gallery'; fi
+  GALLERY_OUTPUT_DIR="$DOWNLOAD_DIR/${tag}_${stamp}_$$"
+  mkdir -p "$GALLERY_OUTPUT_DIR" || return 1
+  OUTPUTS=''; OUTPUT_FILE=''; OUTPUT_COUNT=0
+  for f in "$g_work"/*; do
+    [ -f "$f" ] || continue
+    is_gallery_media "$f" || continue
+    is_temp_artifact "${f##*/}" && continue
+    if mv "$f" "$GALLERY_OUTPUT_DIR/"; then
+      dest="$GALLERY_OUTPUT_DIR/${f##*/}"
+      [ -n "$OUTPUT_FILE" ] || OUTPUT_FILE=$dest
+      OUTPUTS="$OUTPUTS$dest
+"
+      OUTPUT_COUNT=$((OUTPUT_COUNT + 1))
+    else
+      warn "Could not move: ${f##*/}"
+    fi
+  done
+  [ "$OUTPUT_COUNT" -gt 0 ] || return 1
+  [ "$g_rc" -eq 0 ] || warn 'gallery-dl reported some errors; kept every file it could fetch.'
+  log_history
+  say ''
+  say "[C] Saved $OUTPUT_COUNT file(s): $g_imgs photo(s), $g_vids video(s)."
+  say "[C] Folder: $GALLERY_OUTPUT_DIR"
+  [ "$g_imgs" -eq 0 ] || say '[C] Photos: open the folder in Files -> Share -> Save Image.'
+  return 0
+}
