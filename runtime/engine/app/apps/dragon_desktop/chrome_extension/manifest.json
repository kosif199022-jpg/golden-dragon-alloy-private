{
  "manifest_version": 3,
  "name": "التنين الأسود: تحكم كروم",
  "short_name": "التنين الأسود",
  "version": "1.0.0",
  "description": "Connects Chrome to the Black Dragon desktop app on this computer so its assistant can open, read and operate pages you allow.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "التنين الأسود", "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } },
  "icons": { "128": "icon128.png" }
}
