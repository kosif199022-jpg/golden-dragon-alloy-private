  ]
 },
 "laws": {
  "trajectory_memory": {
   "input": "ScalarField2D.grad",
   "output": "ParticleVelocity2D",
   "edge": "stored light → velocity"
  },
  "material_memory": {
   "input": "ScalarField2D.sample",
   "output": "MaterialOpacity",
   "edge": "stored light → material luminance"
  },
  "elastic_memory": {
   "input": "ScalarField2D.grad",
   "output": "ParticleDisplacement2D",
   "edge": "stored light → elastic displacement"
  },
  "self_imprinting": {
   "input": "ParticlePositions2D",
   "output": "ScalarField2D",
   "edge": "particle history → memory field → velocity"
  }
 },
 "brick_patterns": {
  "operations": {
   "path_geometry": "\\.(?:moveTo|lineTo|bezierCurveTo|quadraticCurveTo|arcTo)\\s*\\(",
   "primitive_shapes": "\\.(?:arc|ellipse|rect|roundRect|fillRect|strokeRect)\\s*\\(",
   "fill_stroke": "\\.(?:fill|stroke)\\s*\\(",
   "gradient": "\\.(?:createLinearGradient|createRadialGradient|createConicGradient)\\s*\\(",
   "transform": "\\.(?:translate|rotate|scale|setTransform|transform)\\s*\\(",
   "clip_mask": "\\.(?:clip)\\s*\\(",
   "compositing": "\\.(?:globalCompositeOperation)\\s*=(?!=)",
   "alpha": "\\.(?:globalAlpha)\\s*=(?!=)",
   "blur_filter": "\\.(?:filter|shadowBlur)\\s*=(?!=)",
   "pixel_readback": "\\.(?:getImageData)\\s*\\(",
   "pixel_write": "\\.(?:putImageData|createImageData)\\s*\\(",
   "offscreen_layer": "\\bH\\.layer\\s*\\(|OffscreenCanvas|createElement\\(\\s*['\\\"]canvas",
   "image_composite": "\\.(?:drawImage)\\s*\\(",
   "text": "\\.(?:fillText|strokeText|measureText)\\s*\\(",
   "pattern": "\\.(?:createPattern)\\s*\\(",
   "dash": "\\.(?:setLineDash)\\s*\\("
  },
  "laws": {
   "periodic": "Math\\.(?:sin|cos)\\s*\\(",
   "exponential": "Math\\.exp\\s*\\(",
   "power_curve": "Math\\.pow\\s*\\(|\\*\\*",
   "distance_field": "Math\\.hypot\\s*\\(|Math\\.sqrt\\s*\\(",
   "angle_field": "Math\\.atan2\\s*\\(",
   "quantize": "Math\\.(?:floor|round)\\s*\\(",
   "noise_field": "\\bH\\.makeNoise\\s*\\(|\\.fbm\\w*\\s*\\(|\\.n[23]\\s*\\(",
   "seeded_random": "\\bH\\.rng\\s*\\(",
   "interpolate": "\\bH\\.(?:lerp|mix|map)\\s*\\(",
   "easing": "\\bH\\.(?:ease|smooth)\\b",
   "clamp": "\\bH\\.clamp\\s*\\("
  },
  "time": {
   "eased_reveal": "\\bH\\.(?:ease|smooth)\\b[^;\\n]*\\bt\\b|\\bH\\.clamp\\s*\\(\\s*\\(\\s*t\\s*-",
   "periodic_in_t": "Math\\.(?:sin|cos)\\s*\\([^)]*\\bt\\b",
   "stepped_frames": "Math\\.floor\\s*\\(\\s*t\\s*\\*|Math\\.floor\\s*\\(\\s*\\(?\\s*t\\b",
   "history_resampling": "\\bt\\s*-\\s*\\w+\\s*\\*|\\(\\s*t\\s*-\\s*\\(?\\w+\\s*\\*",
   "beat_windows": "\\bt\\s*[<>]=?\\s*\\d+(?:\\.\\d+)?\\b"
  },
  "memory": {
   "cached_texture": "\\bcache\\w*\\b|\\bH\\.layer\\s*\\(",
   "trail_by_resampling": "\\bt\\s*-\\s*\\w+\\s*\\*|\\(\\s*t\\s*-\\s*\\(?\\w+\\s*\\*",
   "iterative_build": "for\\s*\\([^;]*;[^;]*<\\s*(?:trail|steps|n|N|hist|len|k)\\w*\\s*;",
   "fade_overlay": "globalAlpha\\s*=\\s*0?\\.\\d+[^;]*;\\s*[\\w.]*fillRect"
  },
  "feedback": {
   "pixel_postprocess": "\\.(?:getImageData)\\s*\\(",
   "field_drives_motion": "(?i)\\bgrad\\w*|\\bcurl\\w*|\\bflow\\w*\\s*\\("
  },
  "state": {
   "particle_arrays": "(?i)\\bparticles?\\b|\\bdots\\b|\\bmotes?\\b|\\bstars?\\b|\\bdrops?\\b",
   "polyline_points": "\\bpts\\b|\\bpoints\\b|\\bpath\\b",
   "grid_cells": "\\bcols?\\b|\\brows?\\b|\\bcells?\\b|\\bgrid\\b",
   "glyphs_text": "\\.(?:fillText|strokeText)\\s*\\(",
   "noise_values": "\\bH\\.makeNoise\\s*\\(|\\.fbm\\w*\\s*\\(|\\.n[23]\\s*\\(",
   "palette": "\\bpal\\w*\\b|\\bcolou?rs?\\b|#[0-9a-fA-F]{6}\\b"
  }
 },
 "composite_mode": "globalCompositeOperation\\s*=\\s*['\\\"]([a-z-]+)['\\\"]",
 "tag_support": {
  "glow": "lighter|shadowBlur|screen|blur\\(",
  "light": "lighter|createRadialGradient|screen|shadow",
  "gradient": "create(?:Linear|Radial|Conic)Gradient",
  "noise": "makeNoise|\\.fbm|H\\.grain",
  "grain": "H\\.grain|makeNoise|rng\\(",
  "particles": "particles?|dots|motes?|stars?",
  "path": "lineTo|bezierCurveTo|quadraticCurveTo",
  "trace": "lineTo|\\bt\\s*-\\s*\\w+\\s*\\*|drawOn",
  "mask": "clip\\(|destination-(?:in|out)|source-(?:in|atop)",
  "layer": "H\\.layer|drawImage",
  "grid": "\\bcols?\\b|\\brows?\\b|\\bgrid\\b|\\bcell",
  "pixel": "getImageData|putImageData|imageSmoothingEnabled\\s*=\\s*false|Math\\.floor",
  "field": "makeNoise|getImageData|\\bfield\\b",
  "reflection": "reflect|scale\\(\\s*1\\s*,\\s*-1|mirror",
  "shadow": "shadow",
  "texture": "H\\.paper|H\\.grain|makeNoise|createPattern",
  "blur": "blur\\(|shadowBlur",
  "step": "Math\\.floor\\s*\\(\\s*t|step",
  "ease": "H\\.ease|H\\.smooth",
  "camera": "cam\\w*|translate\\(",
  "decay": "Math\\.exp|decay|fade",
  "accumulate": "lighter|accum|\\bt\\s*-\\s*\\w+\\s*\\*",
  "pulse": "Math\\.sin\\s*\\([^)]*\\bt\\b"
 }
}
