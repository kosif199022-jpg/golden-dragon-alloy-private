{
  "_comment": "Smoke test: exercises ops not covered by the examples. Renders frame 40 (EEVEE) + a short PNG sequence.",
  "scene": {"resolution": [1280, 720], "fps": 24, "frame_start": 1, "frame_end": 48, "engine": "EEVEE", "samples": 16,
            "color": {"view_transform": "AgX", "look": "Medium High Contrast"},
            "world": {"type": "sky", "sun_elevation": 12, "sun_rotation": 40, "strength": 0.3, "fog": {"density": 0.01}}},
  "steps": [
    {"op": "units", "system": "METRIC"},
    {"op": "floor", "name": "Ground", "size": 40, "color": "#3a3a3e"},
    {"op": "import_model", "path": "assets/wedge.obj", "name": "Wedge", "normalize": 1.2, "location": [-3, 0, 0], "material": "clay"},
    {"op": "import_model", "path": "assets/star.svg", "name": "Star", "extrude": 0.02, "svg_scale": 8, "location": [3, 1, 1.4], "rotation": [90, 0, 0], "material": "gold"},
    {"op": "add_primitive", "type": "cube", "name": "Block", "size": 1.2, "location": [0, 0, 0.6], "material": "car_paint"},
    {"op": "add_primitive", "type": "sphere", "name": "Cutter", "size": 1.1, "location": [0.5, -0.5, 1.1]},
    {"op": "boolean", "target": "Block", "cutter": "Cutter"},
    {"op": "bevel", "target": "Block", "width": 0.04},
    {"op": "add_primitive", "type": "torus", "name": "Ring", "size": 0.8, "location": [-1.5, -2, 0.4], "rotation": [90, 0, 0], "material": "chrome"},
    {"op": "array", "target": "Ring", "count": 3, "relative_offset_displace": [1.2, 0, 0]},
    {"op": "add_primitive", "type": "plane", "name": "Sheet", "size": 1.0, "location": [1.8, -2, 0.02]},
    {"op": "solidify", "target": "Sheet", "thickness": 0.08},
    {"op": "material", "name": "Wood", "preset": "wood", "target": "Sheet"},
    {"op": "add_primitive", "type": "cone", "name": "Pebble", "size": 0.15, "location": [0, 0, -20], "material": "rubber"},
    {"op": "scatter", "source": "Pebble", "count": 30, "area": [8, 4, 0], "center": [0, 2.5, 0.05], "seed": 4},
    {"op": "add_primitive", "type": "ico_sphere", "name": "Dot", "size": 0.12, "subdivisions": 2, "location": [0, 0, -20], "material": {"preset": "neon", "color": "#22d3ee", "name": "Cyan"}},
    {"op": "instance_grid", "source": "Dot", "count": [6, 1, 1], "spacing": [0.4, 0, 0], "location": [0, -2.8, 0.15]},
    {"op": "add_primitive", "type": "grid", "name": "Lawn", "size": 2.5, "segments": 8, "location": [4.5, -1.2, 0.01]},
    {"op": "add_primitive", "type": "cone", "name": "Blade", "size": 0.05, "depth": 0.25, "location": [0, 0, -20], "material": {"preset": "plastic", "color": "#4caf50", "name": "Green"}},
    {"op": "gn_scatter", "target": "Lawn", "instance": "Blade", "density": 60, "seed": 2},
    {"op": "gn_text", "text": "نص هندسي", "name": "GNText", "size": 0.7, "depth": 0.1, "location": [-3.2, 1.8, 0.6], "material": "rose_gold"},
    {"op": "gn_set_input", "target": "GNText", "input": "Depth", "value": 0.02, "frame": 1},
    {"op": "gn_set_input", "target": "GNText", "input": "Depth", "value": 0.2, "frame": 30, "easing": "expo_out"},
    {"op": "text3d", "text": "Smoke", "name": "Word", "size": 0.6, "location": [0, 1.5, 0.45], "material": "silver", "split": true},
    {"op": "text_reveal", "target": "Word", "style": "flip", "frame_start": 5, "duration": 20, "stagger": 3},
    {"op": "keyframe", "target": "Cyan", "id_type": "material", "data_path": "nodes[\"Principled BSDF\"].inputs[\"Emission Strength\"].default_value",
     "keys": [{"frame": 1, "value": 0}, {"frame": 30, "value": 25, "easing": "sine_in_out"}]},
    {"op": "noise", "target": "Star", "data_path": "rotation", "strength": 8, "scale": 12},
    {"op": "visibility", "target": "Wedge", "keys": [{"frame": 1, "visible": false}, {"frame": 10, "visible": true}]},
    {"op": "animate", "target": "Block", "property": "rotation", "from_value": [0, 0, 0], "to_value": [0, 0, 45], "frame_start": 1, "frame_end": 40, "easing": "back_out"},
    {"op": "three_point", "intensity": 0.8},
    {"op": "light", "type": "SPOT", "name": "Spot", "location": [0, -4, 5], "target": "Block", "energy": 600, "spot_size": 40},
    {"op": "camera", "name": "Cam", "location": [0, -11, 4], "target": [0, 0, 0.6], "lens": 35},
    {"op": "frame_objects", "margin": 1.05, "direction": [0, -1, 0.45]},
    {"op": "camera_crane", "from_height": 4, "to_height": 5, "frame_start": 1, "frame_end": 48},
    {"op": "camera_zoom", "from_lens": 35, "to_lens": 38, "frame_start": 1, "frame_end": 48},
    {"op": "rack_focus", "from_target": "Block", "to_target": "Star", "fstop": 4, "frame_start": 1, "frame_end": 48},
    {"op": "camera_shake", "strength": 0.01, "speed": 10}
  ],
  "post": {"glare": {"type": "Streaks", "streaks": 6, "threshold": 1.0, "strength": 0.4}, "exposure": 0.1, "saturation": 1.05, "vignette": true},
  "render": [{"type": "still", "out": "smoke_f40.png", "frame": 40},
             {"type": "animation", "out": "seq/smoke_####.png", "frame_start": 1, "frame_end": 6}],
  "save_blend": "smoke_ops.blend"
}
