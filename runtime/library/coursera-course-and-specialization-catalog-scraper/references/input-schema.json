    "handsOnLearningTypes": {
      "title": "Hands-on learning types",
      "type": "array",
      "description": "Only include products with these hands-on learning formats.",
      "editor": "select",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Dialogues And Role Plays",
          "Guided Projects",
          "Coding Labs",
          "Cloud Sandboxes",
          "Gen AI Playgrounds"
        ],
        "enumTitles": [
          "Dialogues and role plays",
          "Guided projects",
          "Coding labs",
          "Cloud sandboxes",
          "Gen AI playgrounds"
        ]
      },
      "default": [],
      "prefill": []
    },
    "tools": {
      "title": "Tools and software",
      "type": "array",
      "description": "Only include products that teach these tools or software skills.",
      "editor": "select",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Amazon Web Services",
          "ChatGPT",
          "Google Gemini",
          "Linux",
          "Power BI",
          "Google Workspace",
          "R (Software)",
          "Anthropic Claude",
          "Jupyter",
