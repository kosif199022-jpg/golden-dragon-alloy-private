    "partners": {
      "title": "Partners / universities",
      "type": "array",
      "description": "Partner or university names, e.g. `IBM`, `Google`, `Stanford Online`, `DeepLearning.AI`. Matched to the live Coursera partner filter; partial names such as `Stanford` are resolved to the closest partner.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "skills": {
      "title": "Skills",
      "type": "array",
      "description": "Skill names, e.g. `Python Programming`, `Machine Learning`. Matched to the live skill filter; partial names are resolved when possible.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "courseraPlusStatus": {
      "title": "Coursera Plus",
      "type": "string",
      "description": "Filter by Coursera Plus inclusion.",
      "editor": "select",
      "enum": [
        "",
        "included",
        "notIncluded"
      ],
      "enumTitles": [
        "Any",
        "Included in Coursera Plus",
        "Not included in Coursera Plus"
      ],
      "default": "",
      "prefill": ""
    },
    "freeOnly": {
      "title": "Free products only",
      "type": "boolean",
      "description": "Only return products whose Coursera cost label is Free. The older audit/verified filter is no longer exposed by Coursera; access flags are included in every record.",
      "default": false,
      "prefill": false
    },
    "sortBy": {
      "title": "Sort by",
      "type": "string",
      "description": "Result order for search, browse, byCategory and byPartner modes.",
      "editor": "select",
      "enum": [
        "BEST_MATCH",
        "NEW"
      ],
      "enumTitles": [
        "Best match",
        "Newest"
      ],
      "default": "BEST_MATCH",
      "prefill": "BEST_MATCH"
    },
    "maxItems": {
      "title": "Max items",
      "type": "integer",
      "description": "Maximum number of records to return (1-1000).",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 3,
      "sectionCaption": "Output",
      "sectionDescription": "Control the export size and optional detail enrichment."
    },
    "includeDetails": {
      "title": "Include course detail fields",
      "type": "boolean",
      "description": "Fetch each product page to add instructors, syllabus/modules, total enrollment, page views, rating breakdown, top reviews, learning objectives, recommended background and membership. Slower: one extra request per record. Lookup modes (bySlug/byUrl/byIds) always return detail fields.",
      "default": false,
      "prefill": false
    }
  },
  "required": [
    "mode"
  ]
}
