# Normalise text to LF in the repository; Windows batch files keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary files
*.jar binary
*.class binary
*.gz binary
*.dat binary
*.png binary
*.zip binary

# Keep maintainer-only files out of `git archive` source downloads
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
