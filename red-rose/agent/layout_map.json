{
  "version": "W07-1",
  "source": "Arabic (101) keyboard layout, unshifted keys (authored from the public key chart)",
  "map": {
    "`": "ذ",
    "q": "ض",
    "w": "ص",
    "e": "ث",
    "r": "ق",
    "t": "ف",
    "y": "غ",
    "u": "ع",
    "i": "ه",
    "o": "خ",
    "p": "ح",
    "[": "ج",
    "]": "د",
    "a": "ش",
    "s": "س",
    "d": "ي",
    "f": "ب",
    "g": "ل",
    "h": "ا",
    "j": "ت",
    "k": "ن",
    "l": "م",
    ";": "ك",
    "'": "ط",
    "z": "ئ",
    "x": "ء",
    "c": "ؤ",
    "v": "ر",
    "b": "لا",
    "n": "ى",
    "m": "ة",
    ",": "و",
    ".": "ز",
    "/": "ظ"
  },
  "layout_chars": "abcdefghijklmnopqrstuvwxyz[];',./`",
  "caps_rule": "An uppercase Latin letter decodes as its Shift key on the Arabic-101 table when that key types a letter, punctuation or tatweel (H=أ, K=،, G=لأ, J=ـ); other uppercase letters decode as their lowercase key. Shift keys that type diacritics (Q W E R A S X) and Z are not decoded: a token that contains one stays as typed.",
  "never_decode": [
    "URLs (contain :// or start with www.)",
    "paths and drive letters (contain \\ or : or two / or start with /)",
    "flags (start with -)",
    "file names with an extension (name.ext)",
    "tokens that contain a digit",
    "tokens that follow a known command word in the same message"
  ],
  "commands": [
    "git",
    "npm",
    "npx",
    "pip",
    "pip3",
    "python",
    "python3",
    "py",
    "ffmpeg",
    "ffprobe",
    "gh",
    "powershell",
    "pwsh",
    "cmd",
    "bash",
    "node",
    "curl",
    "wget",
    "docker",
    "pandoc",
    "magick",
    "blender",
    "whisperx",
    "yt-dlp",
    "rose",
    "rose.py",
    "cd",
    "ls",
    "dir",
    "cp",
    "mv",
    "rm",
    "mkdir",
    "echo",
    "cat",
    "sed",
    "grep",
    "rg",
    "jq",
    "unzip",
    "7z",
    "make"
  ],
  "shift": {
    "T": "لإ",
    "Y": "إ",
    "U": "‘",
    "I": "÷",
    "O": "×",
    "P": "؛",
    "G": "لأ",
    "H": "أ",
    "K": "،",
    "B": "لآ",
    "N": "آ",
    "M": "’",
    "J": "ـ"
  },
  "shift_not_decoded": [
    "Q",
    "W",
    "E",
    "R",
    "A",
    "S",
    "X",
    "Z",
    "?"
  ]
}
